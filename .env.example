# Optional absolute path for the local JSON database. Defaults to data/events.json.
EVENTS_DB_PATH=

# Add the exact browser origin when the UI is served from another address or port.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# Override only when deploying behind a reverse proxy or inside a container.
# HOST=0.0.0.0
PORT=3000
